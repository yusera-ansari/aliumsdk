<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/long_text_ques"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:theme="@style/Theme.AppCompat.Light.NoActionBar"
    android:orientation="vertical">



    <com.google.android.material.textfield.TextInputLayout
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:focusedByDefault="true"
        android:paddingTop="0dp"
        app:hintEnabled="true"
        app:boxBackgroundMode="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/text_input_layout"
        app:placeholderText="Enter your response here"
        app:placeholderTextColor="#2D2828"
        app:boxCornerRadiusBottomEnd="5dp"
        app:boxCornerRadiusBottomStart="5dp"
        app:boxCornerRadiusTopEnd="5dp"
        app:boxCornerRadiusTopStart="5dp"
        app:boxStrokeWidth="0dp"
        android:gravity="center_horizontal"
        app:boxStrokeWidthFocused="0dp"
        android:paddingHorizontal="10dp"
        app:counterMaxLength="280"
        app:counterOverflowTextAppearance="@color/black"
        app:counterEnabled="false"
        app:boxStrokeColor="@color/white"
        android:background="@drawable/text_input_layout_bg"
      >

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            android:gravity="top|start"
            android:layout_gravity="center_horizontal"
            android:id="@+id/text_input_edit_text"
            android:inputType="textMultiLine"
            android:lines="5"
            android:textSize="16sp"
            tools:text="Helloooooo"
            android:paddingTop="0dp"
            android:imeOptions="actionDone"
            android:background="@color/white"

            />
    </com.google.android.material.textfield.TextInputLayout>
</RelativeLayout>